{
  "FormatVersion": 1,
  "Name": "BasicReport",
  "Title": "Basic report",
  "Page": {
    "Width": 1123,
    "Height": 794,
    "MarginLeft": 30,
    "MarginRight": 30,
    "MarginTop": 30,
    "MarginBottom": 30
  },
  "DataSource": {
    "Provider": "Host",
    "ConnectionString": "",
    "Query": "",
    "CommandTimeoutSeconds": 60,
    "Fields": [
      {
        "Name": "CompanyName",
        "Type": "Text"
      },
      {
        "Name": "FactoryID",
        "Type": "Number"
      },
      {
        "Name": "FactoryName",
        "Type": "Text"
      },
      {
        "Name": "EmployeeID",
        "Type": "Number"
      },
      {
        "Name": "EmpCode",
        "Type": "Text"
      },
      {
        "Name": "FullName",
        "Type": "Text"
      },
      {
        "Name": "FatherOrSpouseName",
        "Type": "Text"
      },
      {
        "Name": "Gender",
        "Type": "Text"
      },
      {
        "Name": "DateOfBirth",
        "Type": "Date"
      },
      {
        "Name": "JoinDate",
        "Type": "Date"
      },
      {
        "Name": "ExitDate",
        "Type": "Date"
      },
      {
        "Name": "DesignationName",
        "Type": "Text"
      },
      {
        "Name": "DepartmentName",
        "Type": "Text"
      },
      {
        "Name": "Mobile",
        "Type": "Text"
      },
      {
        "Name": "IsActive",
        "Type": "Boolean"
      }
    ]
  },
  "Parameters": [
    {
      "Name": "CompanyName",
      "Prompt": "Company name",
      "Type": "Text",
      "DefaultValue": ""
    },
    {
      "Name": "AsOnText",
      "Prompt": "As on",
      "Type": "Text",
      "DefaultValue": ""
    }
  ],
  "Groups": [
    {
      "Expression": "FactoryName",
      "StartNewPage": false,
      "RestartPageNumbers": false,
      "Header": {
        "Kind": "GroupHeader",
        "Name": "",
        "Height": 22,
        "Items": [
          {
            "Kind": "Text",
            "X": 0,
            "Y": 2,
            "Width": 1063,
            "Height": 18,
            "Text": "Factory: {FactoryName}",
            "FontSize": 9.5,
            "Bold": true,
            "HAlign": "Left",
            "VAlign": "Middle",
            "ForeColor": "#1F2937",
            "WordWrap": true
          }
        ]
      },
      "Footer": {
        "Kind": "GroupFooter",
        "Name": "",
        "Height": 24,
        "Items": [
          {
            "Kind": "Line",
            "X": 0,
            "Y": 1,
            "Width": 1063,
            "Height": 0,
            "ForeColor": "#9CA3AF",
            "BorderColor": "#9CA3AF",
            "BorderWidth": 1
          },
          {
            "Kind": "Text",
            "X": 0,
            "Y": 3,
            "Width": 400,
            "Height": 18,
            "Text": "Unit total: {Count()}",
            "FontSize": 8.5,
            "Bold": true,
            "HAlign": "Left",
            "VAlign": "Middle",
            "ForeColor": "#1F2937",
            "WordWrap": true
          }
        ]
      }
    }
