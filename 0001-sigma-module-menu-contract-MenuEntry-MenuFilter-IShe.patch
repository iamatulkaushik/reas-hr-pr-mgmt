@@ -2,20 +2,98 @@ Imports System.Drawing
 Imports System.Windows.Forms
 Imports Revolution.UI.Common
 
-''' <summary>Placeholder main window on BaseForm. Replaced by the real shell when the first module lands.</summary>
+''' <summary>
+''' The main window: File menu (switch company for users who work on several, exit) plus the menus the registered modules offer.
+''' Screens opened from the menu are closed when the company changes, so no screen ever shows another company's data (ADR 0016).
+''' </summary>
 Public Class ShellForm
     Inherits BaseForm
 
-    Public Sub New(session As ISessionContext)
-        MyBase.New("Revolution HRMS", "Foundation build")
+    Private ReadOnly _services As AppServices
+    Private ReadOnly _modules As IReadOnlyList(Of IShellModule)
+    Private ReadOnly _menu As New MenuStrip()
+    Private ReadOnly _banner As New Label()
+    Private ReadOnly _openScreens As New List(Of Form)()
+
+    Public Sub New(services As AppServices, modules As IEnumerable(Of IShellModule))
+        MyBase.New("Revolution HRMS", String.Empty)
+        If services Is Nothing Then Throw New ArgumentNullException(NameOf(services))
+        If modules Is Nothing Then Throw New ArgumentNullException(NameOf(modules))
+        _services = services
+        _modules = modules.ToList()
         StartPosition = FormStartPosition.CenterScreen
-        ClientSize = New Size(960, 600)
-        Dim user = session.Current
-        Dim banner As New Label With {
-            .Dock = DockStyle.Fill,
-            .TextAlign = ContentAlignment.MiddleCenter,
-            .Text = If(user Is Nothing, "Not signed in", $"Signed in as {user.UserName} ({user.Role}, {user.Plan})")
-        }
-        Content.Controls.Add(banner)
+        ClientSize = New Size(1100, 700)
+        _banner.Dock = DockStyle.Fill
+        _banner.TextAlign = ContentAlignment.MiddleCenter
+        _menu.Dock = DockStyle.Top
+        ' Fill control first, then the menu, so the menu docks to the top.
+        Content.Controls.Add(_banner)
+        Content.Controls.Add(_menu)
+        MainMenuStrip = _menu
+        RebuildMenu()
+    End Sub
+
+    Private Sub RebuildMenu()
+        _menu.Items.Clear()
+        _menu.Items.Add(BuildFileMenu())
+        For Each top In ShellMenuBuilder.Build(_modules, _services.Permissions, _services.Entitlements, AddressOf OnOpenItem)
+            _menu.Items.Add(top)
+        Next
+        Dim user = _services.Session.Current
+        _banner.Text = If(user Is Nothing, "Not signed in",
+                          $"Signed in as {user.UserName} ({user.Role}, {user.Plan}), company {user.CompanyId}")
+    End Sub
+
+    Private Function BuildFileMenu() As ToolStripMenuItem
+        Dim fileMenu As New ToolStripMenuItem("&File")
+        If CanSwitchCompany() Then
+            Dim switchItem As New ToolStripMenuItem("&Switch company...")
+            AddHandler switchItem.Click, AddressOf OnSwitchCompany
+            fileMenu.DropDownItems.Add(switchItem)
+        End If
+        Dim exitItem As New ToolStripMenuItem("E&xit")
+        AddHandler exitItem.Click, Sub(sender As Object, args As EventArgs) Close()
+        fileMenu.DropDownItems.Add(exitItem)
+        Return fileMenu
+    End Function
+
+    ''' <summary>True when the signed-in user works on more than one company. The auth service decides; the shell never checks a role name.</summary>
+    Private Function CanSwitchCompany() As Boolean
+        Dim companies = _services.Auth.ListCompanies()
+        Return companies.Succeeded AndAlso companies.Value.Count > 1
+    End Function
+
+    Private Sub OnOpenItem(item As ShellItem)
+        If Not _services.Permissions.IsAllowed(item.Entry.ModuleKey, PermissionAction.View) Then
+            ShowError("You do not have permission to open this screen.")
+            Return
+        End If
+        ClearValidation()
+        Dim screen As Form = item.OpenScreen()
+        _openScreens.Add(screen)
+        AddHandler screen.FormClosed, Sub(sender As Object, args As FormClosedEventArgs) _openScreens.Remove(screen)
+        screen.Show(Me)
+    End Sub
+
+    Private Sub OnSwitchCompany(sender As Object, args As EventArgs)
+        If _openScreens.Count > 0 Then
+            Dim answer = MessageBox.Show(Me, "Switching company closes the open screens. Unsaved work is lost. Continue?", Text,
+                                         MessageBoxButtons.YesNo, MessageBoxIcon.Warning)
+            If answer <> DialogResult.Yes Then
+                Return
+            End If
+        End If
+        For Each screen In _openScreens.ToList()
+            screen.Close()
+        Next
+        If _openScreens.Count > 0 Then
+            ShowError("A screen did not close, so the company was not changed. Finish or cancel its work and try again.")
+            Return
+        End If
+        Using picker As New CompanyPickerForm(_services.Auth, _services.AssociateAdmin)
+            If picker.ShowDialog(Me) = DialogResult.OK Then
+                RebuildMenu()
+            End If
+        End Using
     End Sub
 End Class
diff --git a/src/Revolution.Core/MenuEntry.vb b/src/Revolution.Core/MenuEntry.vb
new file mode 100644
index 0000000..4223771
--- /dev/null
+++ b/src/Revolution.Core/MenuEntry.vb
@@ -0,0 +1,36 @@
+''' <summary>
+''' One menu item a module offers the shell. Metadata only: the screen it opens lives in the UI layer (ShellItem).
+''' The shell shows the entry only when the user may View the module and the plan has the required feature (ADR 0016).
+''' </summary>
+Public NotInheritable Class MenuEntry
+    Public Sub New(entryKey As String, menuGroup As String, title As String, moduleKey As ModuleKey,
+                   Optional requiredFeature As PlanFeature? = Nothing, Optional sortOrder As Integer = 100)
+        If String.IsNullOrWhiteSpace(entryKey) Then
+            Throw New ArgumentException("A menu entry needs a key.", NameOf(entryKey))
+        End If
+        If String.IsNullOrWhiteSpace(menuGroup) Then
+            Throw New ArgumentException("A menu entry needs a group.", NameOf(menuGroup))
+        End If
+        If String.IsNullOrWhiteSpace(title) Then
+            Throw New ArgumentException("A menu entry needs a title.", NameOf(title))
+        End If
+        Me.EntryKey = entryKey.Trim()
+        Me.MenuGroup = menuGroup.Trim()
+        Me.Title = title.Trim()
+        Me.ModuleKey = moduleKey
+        Me.RequiredFeature = requiredFeature
+        Me.SortOrder = sortOrder
+    End Sub
+
+    ''' <summary>Unique across all modules, for example "payroll.runs".</summary>
+    Public ReadOnly Property EntryKey As String
+    ''' <summary>The top-level menu the entry sits under, for example "Payroll".</summary>
+    Public ReadOnly Property MenuGroup As String
+    Public ReadOnly Property Title As String
+    ''' <summary>The user needs View on this module to see the entry.</summary>
+    Public ReadOnly Property ModuleKey As ModuleKey
+    ''' <summary>The plan must include this feature. Nothing means any plan.</summary>
+    Public ReadOnly Property RequiredFeature As PlanFeature?
+    ''' <summary>Lower first. Groups follow the order of their first entry.</summary>
+    Public ReadOnly Property SortOrder As Integer
+End Class
diff --git a/src/Revolution.Core/MenuFilter.vb b/src/Revolution.Core/MenuFilter.vb
new file mode 100644
index 0000000..0a822a3
--- /dev/null
+++ b/src/Revolution.Core/MenuFilter.vb
@@ -0,0 +1,23 @@
+''' <summary>Decides which menu entries the signed-in user sees. Asks the permission and entitlement services, never a role or plan name.</summary>
+Public NotInheritable Class MenuFilter
+    Private Sub New()
+    End Sub
+
+    Public Shared Function Visible(entries As IEnumerable(Of MenuEntry), permissions As IPermissionService,
+                                   entitlements As IEntitlementService) As IReadOnlyList(Of MenuEntry)
+        If entries Is Nothing Then Throw New ArgumentNullException(NameOf(entries))
+        If permissions Is Nothing Then Throw New ArgumentNullException(NameOf(permissions))
+        If entitlements Is Nothing Then Throw New ArgumentNullException(NameOf(entitlements))
+        Dim allowed = entries.Where(Function(entry) IsVisible(entry, permissions, entitlements))
+        Dim ordered = allowed.OrderBy(Function(entry) entry.SortOrder).ThenBy(Function(entry) entry.Title, StringComparer.Ordinal)
+        Return ordered.ToList()
+    End Function
+
+    Private Shared Function IsVisible(entry As MenuEntry, permissions As IPermissionService,
+                                      entitlements As IEntitlementService) As Boolean
+        If Not permissions.IsAllowed(entry.ModuleKey, PermissionAction.View) Then
+            Return False
+        End If
+        Return Not entry.RequiredFeature.HasValue OrElse entitlements.IsEnabled(entry.RequiredFeature.Value)
+    End Function
+End Class
