<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Revolution.App</RootNamespace>
    <StartupObject>Revolution.App.Program</StartupObject>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <AssemblyName>RevolutionHRMS</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Import Include="Revolution.Core" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Revolution.Core\Revolution.Core.vbproj" />
    <ProjectReference Include="..\Revolution.Data\Revolution.Data.vbproj" />
    <ProjectReference Include="..\Revolution.Services\Revolution.Services.vbproj" />
    <ProjectReference Include="..\Revolution.UI.Common\Revolution.UI.Common.vbproj" />
  </ItemGroup>
</Project>
